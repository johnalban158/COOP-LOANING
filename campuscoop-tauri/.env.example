# CampusCoop Environment Variables
# Copy this file to .env and fill in your API keys

# ─── Nemotron 3.5 Super VL (Backend AI) ─────────────────────────────
# Get your API key from https://build.nvidia.com/ (NVIDIA NIM)
NEMOTRON_API_KEY=your_nvidia_nim_api_key_here
NEMOTRON_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NEMOTRON_MODEL=nvidia/nemotron-3-5-super-vl

# ─── Deepseek (Frontend AI Config) ──────────────────────────────────
# Get your API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
